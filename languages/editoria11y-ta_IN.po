#: src/Controller/ApiCrawler.php:122
msgid "The crawler is a premium feature."
msgstr "ஊர்வன் (crawler) ஒரு பிரீமியம் அம்சம்."

#: src/Controller/ApiCrawler.php:129
msgid "Editoria11y database upgrade did not complete; the crawler is paused until an administrator retries the upgrade."
msgstr "Editoria11y தரவுத்தள மேம்படுத்தல் முடிவடையவில்லை; ஒரு நிர்வாகி மேம்படுத்தலை மீண்டும் முயற்சிக்கும் வரை ஊர்வன் இடைநிறுத்தப்பட்டுள்ளது."

#: src/Controller/ApiDismissals.php:83
msgid "Results not recorded"
msgstr "முடிவுகள் பதிவு செய்யப்படவில்லை"

#: src/Controller/ApiDismissals.php:411 src/Controller/ApiResults.php:687
msgid "Editoria11y database upgrade did not complete; writes are paused until an administrator retries the upgrade."
msgstr "Editoria11y தரவுத்தள மேம்படுத்தல் முடிவடையவில்லை; ஒரு நிர்வாகி மேம்படுத்தலை மீண்டும் முயற்சிக்கும் வரை எழுத்து செயல்பாடுகள் இடைநிறுத்தப்பட்டுள்ளன."

#: src/Controller/ApiResults.php:712
msgid "Editoria11y database upgrade did not complete; the dashboard is paused until an administrator retries the upgrade."
msgstr "Editoria11y தரவுத்தள மேம்படுத்தல் முடிவடையவில்லை; ஒரு நிர்வாகி மேம்படுத்தலை மீண்டும் முயற்சிக்கும் வரை கட்டுப்பலகை இடைநிறுத்தப்பட்டுள்ளது."

#: src/CustomRules.php:349
msgid "Machine name is required."
msgstr "இயந்திர பெயர் தேவைப்படுகிறது."

#: src/CustomRules.php:352
msgid "Machine name must be lowercase letters, digits, and underscores, starting with a letter."
msgstr "இயந்திர பெயர் சிறிய எழுத்துகள், இலக்கங்கள் மற்றும் அடிக்கோடுகளால் ஆனதாக இருக்க வேண்டும், ஒரு எழுத்தில் தொடங்க வேண்டும்."

#: src/CustomRules.php:357
msgid "Admin label is required."
msgstr "நிர்வாக லேபிள் தேவைப்படுகிறது."

#: src/CustomRules.php:362
msgid "Test grouping ID is required."
msgstr "சோதனை குழு ID தேவைப்படுகிறது."

#: src/CustomRules.php:369
msgid "Test grouping ID may only contain letters, digits, and underscores."
msgstr "சோதனை குழு ID எழுத்துகள், இலக்கங்கள் மற்றும் அடிக்கோடுகளை மட்டுமே கொண்டிருக்க வேண்டும்."

#. translators: %s is a reserved test key like TABLES_SEMANTIC_HEADING.
#: src/CustomRules.php:374
#, php-format
msgid "Test grouping ID \"%s\" is reserved by the v3 migration drop list and cannot be used."
msgstr "சோதனை குழு ID \"%s\" v3 இடம்பெயர்வு பட்டியலால் ஒதுக்கப்பட்டுள்ளது மற்றும் பயன்படுத்த முடியாது."

#: src/CustomRules.php:381
msgid "Tip title is required."
msgstr "குறிப்பு தலைப்பு தேவைப்படுகிறது."

#: src/CustomRules.php:388
msgid "Tip details must contain some visible text."
msgstr "குறிப்பு விவரங்களில் சில காட்சி உரை இருக்க வேண்டும்."

#: src/CustomRules.php:393
msgid "Alert type must be Error or Manual check."
msgstr "எச்சரிக்கை வகை பிழை அல்லது கைமுறை சரிபார்ப்பாக இருக்க வேண்டும்."

#: src/CustomRules.php:399
msgid "Dismiss key must be Text content or Attributes."
msgstr "நிராகரிப்பு விசை உரை உள்ளடக்கம் அல்லது பண்புகளாக இருக்க வேண்டும்."

#: src/CustomRules.php:405
msgid "Filter selector looks like a CSS rule block, not a selector. Remove the curly braces."
msgstr "வடிகட்டி தேர்வி ஒரு CSS விதி தொகுதியை போல் தெரிகிறது, தேர்வி அல்ல. சுருள் அடைப்புகளை அகற்றவும்."

#: src/CustomRules.php:415
msgid "At least one rule criterion is required: a filter selector OR one or more include-text strings."
msgstr "குறைந்தது ஒரு விதி அளவுகோல் தேவைப்படுகிறது: ஒரு வடிகட்டி தேர்வி அல்லது ஒன்று அல்லது அதிக சேர்-உரை சரங்கள்."

#. translators: %s is an unknown element-set value.
#: src/CustomRules.php:425
#, php-format
msgid "Element set \"%s\" is not one of the recognized element categories."
msgstr "தனிம தொகுப்பு \"%s\" அங்கீகரிக்கப்பட்ட தனிம வகைகளில் ஒன்றல்ல."

