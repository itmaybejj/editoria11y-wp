#: src/TestNames.php:128
msgid "Invalid HTML: linked image missing alt attribute"
msgstr "செல்லாத HTML: பிணைக்கப்பட்ட படத்தில் விவரிப்பு வாசகப் பண்புக்கூறு இல்லை"

#: src/TestNames.php:129
msgid "Invalid HTML: image in link missing alt attribute"
msgstr "செல்லாத HTML: பிணைப்பில் உள்ள படத்தில் விவரிப்பு வாசகப் பண்புக்கூறு இல்லை"

#: src/TestNames.php:130
msgid "This link target may be invalid"
msgstr "இந்தப் பிணைப்பின் இலக்கு செல்லாததாக இருக்கலாம்"

#: src/TestNames.php:131
msgid "Should this quote be a heading?"
msgstr "இந்த மேற்கோள் தலைப்பாக இருக்க வேண்டுமா?"

#: src/TestNames.php:132
msgid "Has this document been tagged for screen readers?"
msgstr "இந்த ஆவணம் திரைவாசிப்பான்களுக்கு அடையாளமிடப்பட்டுள்ளதா?"

#: src/TestNames.php:133
msgid "Should this bold text be a heading?"
msgstr "இந்தத் தடிமனான வாசகம் தலைப்பாக இருக்க வேண்டுமா?"

#: src/TestNames.php:134
msgid "Should this have list formatting?"
msgstr "இதற்குப் பட்டியல் வடிவமைப்பு இருக்க வேண்டுமா?"

#: src/TestNames.php:135
msgid "Broken same-page link"
msgstr "செயல்படாத ஒரே பக்கப் பிணைப்பு"

#: src/TestNames.php:136
msgid "Do not justify text"
msgstr "வாசகத்தை நேர்படுத்தாதீர்கள்"

#: src/TestNames.php:137
msgid "Nested interactive layout components"
msgstr "ஒன்றுக்குள் ஒன்றாகப் பிணைக்கப்பட்ட செயல்மேற்கொள்ளும் தளவமைப்புக் கூறுகள்"

#: src/TestNames.php:138
msgid "Is there an alternative for this PDF?"
msgstr "இந்த PDF-க்கு மாற்று வழி உள்ளதா?"

#: src/TestNames.php:139
msgid "Text is too small"
msgstr "வாசகம் மிகவும் சிறியதாக உள்ளது"

#: src/TestNames.php:140
msgid "Large blocks of emphasized text are harder to read"
msgstr "பெரிய அளவில் வலியுறுத்தப்பட்ட வாசகம் வாசிப்பதற்குக் கடினமாக உள்ளது"

#: src/TestNames.php:141
msgid "Do not use sub/superscript as visual formatting"
msgstr "காட்சி வடிவமைப்பிற்காகக் கீழெழுத்து/மேலெழுத்தைப் பயன்படுத்தாதீர்கள்"

#: src/TestNames.php:142
msgid "Only links should be underlined"
msgstr "பிணைப்புகள் மட்டுமே அடிக்கோடிடப்பட வேண்டும்"

#: src/TestNames.php:143
msgid "Is this uppercase text needed?"
msgstr "இந்தப் பேரெழுத்து வாசகம் தேவையானதா?"

#: src/TestNames.php:144
msgid "Are there redundant words in this alt text?"
msgstr "இந்த விவரிப்பு வாசகத்தில் தேவையற்ற வார்த்தைகள் உள்ளனவா?"

#: src/TestNames.php:145
msgid "Tabindex overrides interrupt the focus order"
msgstr "Tabindex மேலெழுதல்கள் கவனம் செலுத்தும் வரிசையைக் குழப்புகின்றன"

#: src/TestNames.php:146
msgid "This header cell needs text"
msgstr "இந்தத் தலைப்புக் கலத்தில் வாசகம் தேவை"

#: src/TestNames.php:147
msgid "This table has an invalid headers attribute"
msgstr "இந்த அட்டவணையில் செல்லாத headers பண்புக்கூறு உள்ளது"

#: src/TestNames.php:148
msgid "This table needs a header row and/or column"
msgstr "இந்த அட்டவணைக்குத் தலைப்பு வரிசை மற்றும்/அல்லது நெடுவரிசை தேவை"

#: src/TestNames.php:149
msgid "Content headings should not be used inside tables"
msgstr "உள்ளடக்கத் தலைப்புகளை அட்டவணைகளுக்குள் பயன்படுத்தக்கூடாது"

#: src/TestNames.php:150
msgid "Invalid HTML list"
msgstr "செல்லாத HTML பட்டியல்"

#: src/TestNames.php:379
msgid "Linked images"
msgstr "இணைக்கப்பட்ட படங்கள்"

#: src/TestNames.php:382
msgid "Tables"
msgstr "அட்டவணைகள்"

#: src/TestNames.php:383
msgid "Text formatting"
msgstr "உரை வடிவமைப்பு"

#: src/TestNames.php:384
msgid "Video, audio, frames"
msgstr "வீடியோ, ஆடியோ, சட்டங்கள்"

#: src/TestNames.php:385
msgid "Contrast"
msgstr "மாறுபாடு"

#: src/TestNames.php:386
msgid "Forms"
msgstr "படிவங்கள்"

#: src/TestNames.php:387
msgid "ARIA and focus"
msgstr "ARIA மற்றும் கவனம்"

#: src/TestNames.php:388
