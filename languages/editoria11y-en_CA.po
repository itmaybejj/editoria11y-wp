# Canadian English dialect overlay. Contains ONLY entries that differ from
# American English (color/colour and a handful of noun forms — Canadian
# keeps American -ize/-yze and most -er/-or spellings). Empty msgstr in
# WP's locale layer falls through to the msgid.
#
# Append new dialect-sensitive entries via:
#   python3 scripts/scan-dialect-strings.py --apply

msgid "Editoria11y License & Account"
msgstr "Editoria11y Licence & Account"

msgid "Editoria11y License"
msgstr "Editoria11y Licence"

msgid "License & Account"
msgstr "Licence & Account"

msgid "Locked rules are enforced on every site: per-site admins cannot disable them, and a per-site rule sharing this ID is suppressed in favor of this one. Unlocked rules can be disabled per-site."
msgstr "Locked rules are enforced on every site: per-site admins cannot disable them, and a per-site rule sharing this ID is suppressed in favour of this one. Unlocked rules can be disabled per-site."

msgid "Editoria11y license"
msgstr "Editoria11y licence"

msgid "Only network administrators can manage the Editoria11y license."
msgstr "Only network administrators can manage the Editoria11y licence."

msgid "License activated on every site in the network."
msgstr "Licence activated on every site in the network."

msgid "License deactivated on every site in the network."
msgstr "Licence deactivated on every site in the network."

msgid "Activation cancelled. Already-activated sites keep their license."
msgstr "Activation cancelled. Already-activated sites keep their licence."

msgid "Paste your Editoria11y CSA license key to begin."
msgstr "Paste your Editoria11y CSA licence key to begin."

msgid "Deactivate the Editoria11y CSA license on every site in this network? Each site's license slot will be returned to your Freemius account."
msgstr "Deactivate the Editoria11y CSA licence on every site in this network? Each site's licence slot will be returned to your Freemius account."

msgid "Activate your license"
msgstr "Activate your licence"

msgid "Deactivate license network-wide"
msgstr "Deactivate licence network-wide"

msgid "Editoria11y CSA license"
msgstr "Editoria11y CSA licence"

msgid "Activate your Editoria11y CSA license on every site in this network. Activation runs in the background via WP-Cron; you can leave this page open or come back later."
msgstr "Activate your Editoria11y CSA licence on every site in this network. Activation runs in the background via WP-Cron; you can leave this page open or come back later."

msgid "License key"
msgstr "Licence key"

msgid "Removes the Editoria11y CSA license from every site on the network. Each site's install record stays in place; only the license link is cleared."
msgstr "Removes the Editoria11y CSA licence from every site on the network. Each site's install record stays in place; only the licence link is cleared."

msgid "License key is required."
msgstr "Licence key is required."

msgid "License key is no longer stored. Start a new activation."
msgstr "Licence key is no longer stored. Start a new activation."

msgid "Deactivation API call did not clear the install license."
msgstr "Deactivation API call did not clear the install licence."

msgid "To activate the community-supported features and continue receiving updates, either enter your existing license key below or view options for %s."
msgstr "To activate the community-supported features and continue receiving updates, either enter your existing licence key below or view options for %s."

msgid "Editoria11y CSA: the loaded Freemius SDK (version %1$s) is newer than the highest tested version (%2$s). Another Freemius-using plugin on this site has bundled a newer SDK build. The network license activation page may not behave as expected; review release notes or contact support if you hit issues."
msgstr "Editoria11y CSA: the loaded Freemius SDK (version %1$s) is newer than the highest tested version (%2$s). Another Freemius-using plugin on this site has bundled a newer SDK build. The network licence activation page may not behave as expected; review release notes or contact support if you hit issues."

msgid "Editoria11y network licenses are activated from a dedicated page that walks every site in the network in cron-driven batches. This avoids the SDK's 1,000-site limit and keeps the page responsive on large multisites."
msgstr "Editoria11y network licences are activated from a dedicated page that walks every site in the network in cron-driven batches. This avoids the SDK's 1,000-site limit and keeps the page responsive on large multisites."

msgid "Open Editoria11y license page"
msgstr "Open Editoria11y licence page"

msgid "Per-site license rows are not shown to keep this page responsive on large networks. The license you choose below applies to every site in the network. To activate or deactivate on individual sites, visit each site's per-site Settings → Editoria11y → License & Account."
msgstr "Per-site licence rows are not shown to keep this page responsive on large networks. The licence you choose below applies to every site in the network. To activate or deactivate on individual sites, visit each site's per-site Settings → Editoria11y → Licence & Account."

