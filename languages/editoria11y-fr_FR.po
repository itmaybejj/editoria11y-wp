#. Plugin Name of the plugin
#: editoria11y.php
msgid "Editoria11y Accessibility Checker (CSA)"
msgstr "Vérificateur d'accessibilité Editoria11y (CSA)"

#. Plugin URI of the plugin
#: editoria11y.php
msgid "https://wordpress.org/plugins/editoria11y-accessibility-checker/"
msgstr "https://wordpress.org/plugins/editoria11y-accessibility-checker/"

#. Description of the plugin
#: editoria11y.php
msgid "User friendly content quality assurance, plus the CSA developer suite: ~50 additional code and contrast tests, a custom test builder, role-based test configuration, and a site crawler."
msgstr "Assurance qualité du contenu conviviale, ainsi que la suite développeur CSA : ~50 tests de code et de contraste supplémentaires, un constructeur de tests personnalisés, une configuration des tests par rôle et un explorateur de site."

#. Author of the plugin
#: editoria11y.php
msgid "Princeton University, WDS"
msgstr "Princeton University, WDS"

#. Author URI of the plugin
#: editoria11y.php
msgid "https://editoria11y.com"
msgstr "https://editoria11y.com"

#: editoria11y.php:58
msgid "Editoria11y is missing its vendored dependencies. Run \"composer install\" inside the plugin directory or reinstall the plugin from a complete release archive."
msgstr "Editoria11y ne trouve pas ses dépendances vendor. Exécutez « composer install » dans le répertoire du plugin ou réinstallez le plugin à partir d’une archive de version complète."

