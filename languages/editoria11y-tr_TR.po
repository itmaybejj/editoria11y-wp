#: src/Form/SettingsFields.php:69
msgid "Exclude elements that show unhelpful, repetitive, or inaccurate alerts."
msgstr "Yardımcı olmayan, tekrarlayan veya hatalı uyarılar gösteren öğeleri hariç tutun."

