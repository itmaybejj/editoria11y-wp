msgstr "Figyelmeztesse a felhasználókat, ha az elemek esetleg nem láthatók a tippekre ugráskor"

#: src/Form/SettingsFields.php:1017
msgid "Elements with overflow hidden"
msgstr "Overflow hidden tulajdonságú elemek"

#: src/Form/SettingsFields.php:1018
