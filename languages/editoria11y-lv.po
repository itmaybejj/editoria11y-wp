msgstr "Noklusējums jaunajām vietnēm"

#: src/Form/SettingsContext.php:285 src/Form/SettingsContext.php:320
msgid "Default for all sites (skip custom values)"
msgstr "Noklusējums visām vietnēm (ignorēt pielāgotās vērtības)"

