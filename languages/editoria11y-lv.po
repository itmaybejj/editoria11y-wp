msgstr "Tīkla noklusējumu izplatīšana neizdevās."

#: src/Form/NetworkSettingsPage.php:421
msgid "Network defaults propagation idle."
msgstr "Tīkla noklusējumu izplatīšana dīkstāvē."

#: src/Form/SettingsContext.php:214
msgid "Managed at the network level"
msgstr "Pārvaldīts tīkla līmenī"

