msgid "Prefer visible labels to placeholders"
msgstr "Priekšroku dodiet redzamām etiķetēm, nevis vietturiem"

#: src/TestNames.php:86
msgid "Is this reset button needed?"
msgstr "Vai šī atiestatīšanas poga ir nepieciešama?"

#: src/TestNames.php:87
