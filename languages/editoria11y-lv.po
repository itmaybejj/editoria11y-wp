msgstr "Kļūdas: %s (saglabāta jaunākā). Skatiet servera žurnālus sīkākai informācijai."

#: src/Form/NetworkSettingsPage.php:349
msgid "Saving the form now will restart propagation with the new settings."
msgstr "Saglabājot veidlapu tagad, propagācija tiks restartēta ar jaunajiem iestatījumiem."

#: src/Form/NetworkSettingsPage.php:412
msgid "Propagating network defaults to existing sites…"
msgstr "Izplata tīkla noklusējumus uz esošajām vietnēm…"

#: src/Form/NetworkSettingsPage.php:415
msgid "Network defaults propagated."
msgstr "Tīkla noklusējumi izplatīti."

