#. Plugin Name of the plugin
#: editoria11y.php
msgid "Editoria11y Accessibility Checker (CSA)"
msgstr "Pemeriksa Aksesibilitas Editoria11y (CSA)"

#. Plugin URI of the plugin
#: editoria11y.php
msgid "https://wordpress.org/plugins/editoria11y-accessibility-checker/"
msgstr "https://wordpress.org/plugins/editoria11y-accessibility-checker/"

#. Description of the plugin
#: editoria11y.php
msgid "User friendly content quality assurance, plus the CSA developer suite: ~50 additional code and contrast tests, a custom test builder, role-based test configuration, and a site crawler."
msgstr "Jaminan kualitas konten yang ramah pengguna, ditambah rangkaian developer CSA: ~50 tes kode dan kontras tambahan, pembangun tes kustom, konfigurasi tes berbasis peran, dan crawler situs."

#. Author of the plugin
#: editoria11y.php
msgid "Princeton University, WDS"
msgstr "Universitas Princeton, WDS"

#. Author URI of the plugin
#: editoria11y.php
msgid "https://editoria11y.com"
msgstr "https://editoria11y.com"

#: editoria11y.php:131
msgid "Editoria11y is missing its vendored dependencies. Run \"composer install\" inside the plugin directory or reinstall the plugin from a complete release archive."
msgstr "Editoria11y kehilangan dependensi vendor-nya. Jalankan \"composer install\" di dalam direktori plugin atau instal ulang plugin dari arsip rilis yang lengkap."

