#: src/CustomRules.php:273
msgid "Machine name is required."
msgstr "Maskinnavn er påkrevd."

#: src/CustomRules.php:276
msgid "Machine name must be lowercase letters, digits, and underscores, starting with a letter."
msgstr "Maskinnavn må bestå av små bokstaver, sifre og understrek, og starte med en bokstav."

#: src/CustomRules.php:281
msgid "Admin label is required."
msgstr "Administratoretikett er påkrevd."

#: src/CustomRules.php:286
msgid "Test grouping ID is required."
msgstr "Testgruppe-ID er påkrevd."

#: src/CustomRules.php:293
msgid "Test grouping ID may only contain letters, digits, and underscores."
msgstr "Testgruppe-ID kan bare inneholde bokstaver, sifre og understrek."

#. translators: %s is a reserved test key like TABLES_SEMANTIC_HEADING.
#: src/CustomRules.php:298
#, php-format
msgid "Test grouping ID \"%s\" is reserved by the v3 migration drop list and cannot be used."
msgstr "Testgruppe-ID \"%s\" er reservert av v3-migrasjonens utelatelsesliste og kan ikke brukes."

#: src/CustomRules.php:305
msgid "Tip title is required."
msgstr "Tips-tittel er påkrevd."

#: src/CustomRules.php:312
msgid "Tip details must contain some visible text."
msgstr "Tips-detaljer må inneholde synlig tekst."

#: src/CustomRules.php:317
msgid "Alert type must be Error or Manual check."
msgstr "Varseltype må være Feil eller Manuell sjekk."

#: src/CustomRules.php:323
msgid "Dismiss key must be Text content or Attributes."
msgstr "Avvisningsnøkkel må være Tekstinnhold eller Attributter."

#: src/CustomRules.php:329
msgid "Filter selector looks like a CSS rule block, not a selector. Remove the curly braces."
msgstr "Filtervelgeren ser ut som en CSS-regelblokk, ikke en velger. Fjern krøllparentesene."

#: src/CustomRules.php:332
msgid "Filter selector has an unclosed quote, bracket, or parenthesis. The browser would reject it and skip every custom rule on the page."
msgstr "Filtervelgeren har et anførselstegn, en brakett eller en parentes som ikke er lukket. Nettleseren vil avvise den og hoppe over alle egendefinerte regler på siden."

#: src/CustomRules.php:342
msgid "At least one rule criterion is required: a filter selector OR one or more include-text strings."
msgstr "Minst ett regelkriterium er påkrevd: en filtervelger ELLER én eller flere inkluder-tekststrenger."

#. translators: %s is an unknown element-set value.
#: src/CustomRules.php:352
#, php-format
msgid "Element set \"%s\" is not one of the recognized element categories."
msgstr "Elementsettet \"%s\" er ikke en av de gjenkjente elementkategoriene."

