#. Plugin Name of the plugin
#: editoria11y.php
msgid "Editoria11y Accessibility Checker (CSA)"
msgstr "Verificatore di accessibilità Editoria11y (CSA)"

#. Plugin URI of the plugin
#: editoria11y.php
msgid "https://wordpress.org/plugins/editoria11y-accessibility-checker/"
msgstr "https://wordpress.org/plugins/editoria11y-accessibility-checker/"

#. Description of the plugin
#: editoria11y.php
msgid "User friendly content quality assurance, plus the CSA developer suite: ~50 additional code and contrast tests, a custom test builder, role-based test configuration, and a site crawler."
msgstr "Controllo qualità dei contenuti facile da usare, più la suite per sviluppatori CSA: circa 50 test aggiuntivi su codice e contrasto, un generatore di test personalizzati, la configurazione dei test in base al ruolo e un crawler del sito."

#. Author of the plugin
#: editoria11y.php
msgid "Princeton University, WDS"
msgstr "Princeton University, WDS"

#. Author URI of the plugin
#: editoria11y.php
msgid "https://editoria11y.com"
msgstr "https://editoria11y.com"

#: editoria11y.php:131
msgid "Editoria11y is missing its vendored dependencies. Run \"composer install\" inside the plugin directory or reinstall the plugin from a complete release archive."
msgstr "Mancano le dipendenze vendor di Editoria11y. Esegui \"composer install\" nella directory del plugin o reinstalla il plugin da un archivio di rilascio completo."

