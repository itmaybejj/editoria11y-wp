#: src/CustomRules.php:349
msgid "Machine name is required."
msgstr "Il nome macchina è obbligatorio."

#: src/CustomRules.php:352
msgid "Machine name must be lowercase letters, digits, and underscores, starting with a letter."
msgstr "Il nome macchina può contenere solo lettere minuscole, cifre e trattini bassi e deve iniziare con una lettera."

#: src/CustomRules.php:357
msgid "Admin label is required."
msgstr "L’etichetta amministrativa è obbligatoria."

#: src/CustomRules.php:362
msgid "Test grouping ID is required."
msgstr "L’ID di raggruppamento test è obbligatorio."

#: src/CustomRules.php:369
msgid "Test grouping ID may only contain letters, digits, and underscores."
msgstr "L’ID di raggruppamento test può contenere solo lettere, cifre e trattini bassi."

#. translators: %s is a reserved test key like TABLES_SEMANTIC_HEADING.
#: src/CustomRules.php:374
#, php-format
msgid "Test grouping ID \"%s\" is reserved by the v3 migration drop list and cannot be used."
msgstr "L’ID di raggruppamento test \"%s\" è riservato dall’elenco di esclusione della migrazione v3 e non può essere utilizzato."

#: src/CustomRules.php:381
msgid "Tip title is required."
msgstr "Il titolo del suggerimento è obbligatorio."

#: src/CustomRules.php:388
msgid "Tip details must contain some visible text."
msgstr "I dettagli del suggerimento devono contenere del testo visibile."

#: src/CustomRules.php:393
msgid "Alert type must be Error or Manual check."
msgstr "Il tipo di avviso deve essere Errore o Verifica manuale."

#: src/CustomRules.php:399
msgid "Dismiss key must be Text content or Attributes."
msgstr "La chiave di chiusura deve essere Contenuto testuale o Attributi."

#: src/CustomRules.php:405
msgid "Filter selector looks like a CSS rule block, not a selector. Remove the curly braces."
msgstr "Il selettore filtro sembra un blocco di regole CSS, non un selettore. Rimuovi le parentesi graffe."

#: src/CustomRules.php:415
msgid "At least one rule criterion is required: a filter selector OR one or more include-text strings."
msgstr "È richiesto almeno un criterio della regola: un selettore filtro OPPURE una o più stringhe di testo da includere."

#. translators: %s is an unknown element-set value.
#: src/CustomRules.php:425
#, php-format
msgid "Element set \"%s\" is not one of the recognized element categories."
msgstr "L’insieme di elementi \"%s\" non rientra nelle categorie di elementi riconosciute."

