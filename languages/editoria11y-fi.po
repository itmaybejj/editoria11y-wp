#. Plugin Name of the plugin
#: editoria11y.php
msgid "Editoria11y Accessibility Checker (CSA)"
msgstr "Editoria11y-saavutettavuustarkistus (CSA)"

#. Plugin URI of the plugin
#: editoria11y.php
msgid "https://wordpress.org/plugins/editoria11y-accessibility-checker/"
msgstr "https://wordpress.org/plugins/editoria11y-accessibility-checker/"

#. Description of the plugin
#: editoria11y.php
msgid "User friendly content quality assurance, plus the CSA developer suite: ~50 additional code and contrast tests, a custom test builder, role-based test configuration, and a site crawler."
msgstr "Käyttäjäystävällinen sisällön laadunvarmistus sekä CSA-kehittäjäpaketti: ~50 lisäkoodi- ja kontrastitestiä, mukautettu testinluontiväline, roolikohtainen testikonfiguraatio ja sivuston crawler."

#. Author of the plugin
#: editoria11y.php
msgid "Princeton University, WDS"
msgstr "Princetonin yliopisto, WDS"

#. Author URI of the plugin
#: editoria11y.php
msgid "https://editoria11y.com"
msgstr "https://editoria11y.com"

#: editoria11y.php:131
msgid "Editoria11y is missing its vendored dependencies. Run \"composer install\" inside the plugin directory or reinstall the plugin from a complete release archive."
msgstr "Editoria11y-lisäosalta puuttuvat vendoroidut riippuvuudet. Suorita \"composer install\" lisäosan hakemistossa tai asenna lisäosa uudelleen täydellisestä julkaisuarkistosta."

