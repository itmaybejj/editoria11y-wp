msgid "Managed at the network level"
msgstr "Управлява се на мрежово ниво"

#: src/Form/SettingsContext.php:250 src/Form/SettingsContext.php:285
msgid "— No network default —"
msgstr "— Без мрежова стойност по подразбиране —"

#: src/Form/SettingsContext.php:251 src/Form/SettingsContext.php:286
