msgstr "На страницата липсва заглавие от ниво 1"

#: src/TestNames.php:76
msgid "This heading is tagged at the wrong level"
msgstr "Това заглавие е на грешно ниво"

#: src/TestNames.php:77
msgid "This heading is unpronounceable"
msgstr "Това заглавие не може да се прочете"

#: src/TestNames.php:78
msgid "This element cannot be described by screen readers"
msgstr "Екранните четци не могат да опишат този елемент"

#: src/TestNames.php:79
msgid "Can this alt text be shorter?"
msgstr "Може ли алтернативният текст да е по-кратък?"

#: src/TestNames.php:80
msgid "Is this image actually meaningless?"
msgstr "Наистина ли е безсмислено това изображение?"

#: src/TestNames.php:81
msgid "Image in a carousel or gallery marked as decorative"
msgstr "Изображение в галерия/слайдшоу е маркирано като декоративно"

#: src/TestNames.php:82
msgid "This captioned image has no alt text"
msgstr "Изображението с надпис няма алтернативен текст"

#: src/TestNames.php:83
msgid "Alt text should not be the same as caption text"
msgstr "Алтернативният текст не трябва да съвпада с надписа"

#: src/TestNames.php:84
