msgstr "«Autodetectar» selecciona:<br><em><code>body &gt; *:not(#wpadminbar, script, style, .ed11y-element)</code></em>"

#: src/Form/SettingsFields.php:510
msgid "Specify regions to check"
msgstr "Especificar las regiones a comprobar"

