#. Plugin Name of the plugin
#: editoria11y.php
msgid "Editoria11y Accessibility Checker (CSA)"
msgstr "Comprobador de accesibilidad Editoria11y (CSA)"

#. Plugin URI of the plugin
#: editoria11y.php
msgid "https://wordpress.org/plugins/editoria11y-accessibility-checker/"
msgstr "https://wordpress.org/plugins/editoria11y-accessibility-checker/"

#. Description of the plugin
#: editoria11y.php
msgid "User friendly content quality assurance, plus the CSA developer suite: ~50 additional code and contrast tests, a custom test builder, role-based test configuration, and a site crawler."
msgstr "Control de calidad de contenido fácil de usar, además de la suite de desarrollador CSA: ~50 pruebas adicionales de código y contraste, un creador de pruebas personalizado, configuración de pruebas por roles y un rastreador de sitio."

#. Author of the plugin
#: editoria11y.php
msgid "Princeton University, WDS"
msgstr "Princeton University, WDS"

#. Author URI of the plugin
#: editoria11y.php
msgid "https://editoria11y.com"
msgstr "https://editoria11y.com"

#: editoria11y.php:58
msgid "Editoria11y is missing its vendored dependencies. Run \"composer install\" inside the plugin directory or reinstall the plugin from a complete release archive."
msgstr "A Editoria11y le faltan sus dependencias del vendor. Ejecute «composer install» dentro del directorio del plugin o reinstale el plugin desde un archivo completo de la versión."

