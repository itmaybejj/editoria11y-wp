#: src/TestNames.php:77
msgid "This element cannot be described by screen readers"
msgstr "Ekrano skaitytuvai negali aprašyti šio elemento"

#: src/TestNames.php:78
msgid "This heading is unpronounceable"
msgstr "Šios antraštės neįmanoma ištarti"

