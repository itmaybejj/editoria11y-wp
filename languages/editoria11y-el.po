msgstr "Έχει αυτό το placeholder επαρκή αντίθεση;"

#: src/TestNames.php:60
msgid "Does this text have enough contrast?"
msgstr "Έχει αυτό το κείμενο επαρκή αντίθεση;"

#: src/TestNames.php:61
msgid "Does this graphic or icon have enough contrast?"
msgstr "Έχει αυτό το γραφικό επαρκή αντίθεση;"

#: src/TestNames.php:62
msgid "Duplicate ID attribute"
msgstr "Διπλό ID (αναγνωριστικό)"

#: src/TestNames.php:63
msgid "This link has a tooltip with the same text as the link"
