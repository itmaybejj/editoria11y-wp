#. Plugin Name of the plugin
#: editoria11y.php
msgid "Editoria11y Accessibility Checker (CSA)"
msgstr "Verificador de Acessibilidade Editoria11y (CSA)"

#. Plugin URI of the plugin
#: editoria11y.php
msgid "https://wordpress.org/plugins/editoria11y-accessibility-checker/"
msgstr "https://wordpress.org/plugins/editoria11y-accessibility-checker/"

#. Description of the plugin
#: editoria11y.php
msgid "User friendly content quality assurance, plus the CSA developer suite: ~50 additional code and contrast tests, a custom test builder, role-based test configuration, and a site crawler."
msgstr "Garantia de qualidade de conteúdo, fácil de utilizar, mais o conjunto CSA para desenvolvedores: cerca de 50 testes adicionais de código e contraste, um construtor de testes personalizado, configuração de testes por papel e um rastreador do site."

#. Author of the plugin
#: editoria11y.php
msgid "Princeton University, WDS"
msgstr "Princeton University, WDS"

#. Author URI of the plugin
#: editoria11y.php
msgid "https://editoria11y.com"
msgstr "https://editoria11y.com"

#: editoria11y.php:131
msgid "Editoria11y is missing its vendored dependencies. Run \"composer install\" inside the plugin directory or reinstall the plugin from a complete release archive."
msgstr "O Editoria11y não encontra as suas dependências do vendor. Execute \"composer install\" no diretório do plugin ou reinstale-o a partir de um arquivo completo da versão."

