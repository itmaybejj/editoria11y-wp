#. Plugin Name of the plugin
#: editoria11y.php
msgid "Editoria11y Accessibility Checker"
msgstr "Editoria11y Accessibility Checker"

#. Plugin URI of the plugin
#: editoria11y.php
msgid "https://wordpress.org/plugins/editoria11y-accessibility-checker/"
msgstr "https://wordpress.org/plugins/editoria11y-accessibility-checker/"

#. Description of the plugin
#: editoria11y.php
msgid "User friendly content quality assurance. Checks automatically, highlights issues inline, and provides straightforward, easy-to-understand tips."
msgstr "Užívateľsky prívetivé zabezpečenie kvality obsahu. Automaticky kontroluje, priamo zvýrazňuje problémy a poskytuje zrozumiteľné a jednoduché tipy."

#. Author of the plugin
#: editoria11y.php
msgid "Princeton University, WDS"
msgstr "Princeton University, WDS"

#. Author URI of the plugin
#: editoria11y.php
msgid "https://editoria11y.com"
msgstr "https://editoria11y.com"

#: editoria11y.php:58
msgid "Editoria11y is missing its vendored dependencies. Run \"composer install\" inside the plugin directory or reinstall the plugin from a complete release archive."
msgstr "Editoria11y nemá vendorové závislosti. Spustite príkaz „composer install\" v adresári doplnku alebo ho preinštalujte z kompletného archívu vydania."

#: editoria11y.php:282
msgid "Every fifteen minutes (Editoria11y rehash)"
msgstr "Každých pätnásť minút (prepočítanie Editoria11y)"

