msgstr "Denne alt‑tekst kan ikke udtales"

#: src/TestNames.php:51
msgid "This custom input field is missing a label"
msgstr "Dette tilpassede inputfelt mangler en etiket"

#: src/TestNames.php:52
msgid "Button is missing an accessible label"
msgstr "Knappen mangler et tilgængeligt navn"

