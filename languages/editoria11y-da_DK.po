msgstr "Knappen har et ugyldigt ARIA‑label"

#: src/TestNames.php:54
msgid "Button name repeats the word \"button\""
msgstr "Knappens navn gentager ordet “button”"

#: src/TestNames.php:55
msgid "Text does not have enough contrast to be easily legible"
msgstr "Teksten har utilstrækkelig kontrast og er svær at læse"

#: src/TestNames.php:56
msgid "Graphic or icon does not have enough contrast"
msgstr "Grafik eller ikon har utilstrækkelig kontrast"

#: src/TestNames.php:57
msgid "Input does not provide enough contrast to be easily legible"
msgstr "Inputfeltet har utilstrækkelig kontrast og er svært at læse"

#: src/TestNames.php:58
msgid "Placeholder text does not have enough contrast to be easily legible"
msgstr "Placeholder‑tekst har utilstrækkelig kontrast og er svær at læse"

#: src/TestNames.php:59
msgid "Does this placeholder text have enough contrast?"
msgstr "Har denne placeholder‑tekst tilstrækkelig kontrast?"

#: src/TestNames.php:60
msgid "Does this text have enough contrast?"
msgstr "Har denne tekst tilstrækkelig kontrast?"

#: src/TestNames.php:61
msgid "Does this graphic or icon have enough contrast?"
msgstr "Har denne grafik eller dette ikon tilstrækkelig kontrast?"

#: src/TestNames.php:62
msgid "Duplicate ID attribute"
