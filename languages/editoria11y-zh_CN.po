#. Plugin Name of the plugin
#: editoria11y.php
msgid "Editoria11y Accessibility Checker (CSA)"
msgstr "Editoria11y 无障碍检查器（CSA）"

#. Plugin URI of the plugin
#: editoria11y.php
msgid "https://wordpress.org/plugins/editoria11y-accessibility-checker/"
msgstr "https://wordpress.org/plugins/editoria11y-accessibility-checker/"

#. Description of the plugin
#: editoria11y.php
msgid "User friendly content quality assurance, plus the CSA developer suite: ~50 additional code and contrast tests, a custom test builder, role-based test configuration, and a site crawler."
msgstr "用户友好的内容质量保证，外加 CSA 开发者套件：约 50 项额外的代码与对比度测试、自定义测试构建器、基于角色的测试配置，以及站点爬取工具。"

#. Author of the plugin
#: editoria11y.php
msgid "Princeton University, WDS"
msgstr "Princeton University, WDS"

#. Author URI of the plugin
#: editoria11y.php
msgid "https://editoria11y.com"
msgstr "https://editoria11y.com"

#: editoria11y.php:58
msgid "Editoria11y is missing its vendored dependencies. Run \"composer install\" inside the plugin directory or reinstall the plugin from a complete release archive."
msgstr "Editoria11y 缺少所需的依赖文件。请在插件目录中运行 \"composer install\"，或使用完整的发行包重新安装该插件。"

