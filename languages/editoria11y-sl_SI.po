#: src/Form/SettingsPage.php:121
#, php-format
msgid "This site has the community-supported \"CSA\" version of Editoria11y installed rather than the %s."
msgstr "Na tem mestu je nameščena skupnostno podprta različica „CSA“ Editoria11y namesto %s."

#. translators: %s: link reading "becoming a supporter".
#: src/Form/SettingsPage.php:130
#, php-format
msgid "To activate the community-supported features and continue receiving updates, either enter your existing license key below or view options for %s."
msgstr "Če želite aktivirati skupnostno podprte funkcije in nadaljevati prejemanje posodobitev, vnesite obstoječi licenčni ključ spodaj ali si oglejte možnosti za %s."

#: src/Form/SettingsPage.php:155
msgid "Editoria11y License & Account"
msgstr "Licenca in račun Editoria11y"

#: src/Form/SettingsPage.php:240
msgid "Settings"
msgstr "Nastavitve"

#: src/Form/SettingsPage.php:241 src/Form/SettingsPage.php:253
msgid "License & Account"
msgstr "Licenca in račun"

#: src/Form/SettingsPage.php:252
msgid "Contact us"
msgstr "Kontaktirajte nas"

#: src/Form/SettingsPage.php:491
